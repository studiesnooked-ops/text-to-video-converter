# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Video Settings
OUTPUT_DIR=/tmp/output
VIDEO_FPS=24
VIDEO_CODEC=libx264
VIDEO_PRESET=medium

# Text-to-Video Settings
FONT_SIZE=24
FONT_COLOR=white
BACKGROUND_COLOR=black
DURATION_PER_LINE=2
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# PDF Settings
EXTRACT_IMAGES=false

# Network Settings
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3

# TTS Settings
TTS_LANGUAGE=en
TTS_SLOW=false

# Flask Settings (for webhook mode)
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000
